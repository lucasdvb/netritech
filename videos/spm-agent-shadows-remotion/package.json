{
  "name": "spm-agent-shadows-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "SPM Agent Shadows: 8s scroll-scrub hero film built in Remotion",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "prep": "python3 scripts/prep-assets.py && python3 scripts/prep-3d.py",
    "stills": "bash scripts/stills.sh out/stills 0 21 60 93 120 140 165 189 204 219 235",
    "render": "remotion render src/index.ts SpmAgentShadows out/spm-agent-shadows-remotion.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --muted --image-format=png --gl=angle --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "render:scrub": "ffmpeg -y -i out/spm-agent-shadows-remotion.mp4 -c:v libx264 -crf 16 -preset slow -pix_fmt yuv420p -g 1 -keyint_min 1 -sc_threshold 0 -an -movflags +faststart out/spm-agent-shadows-remotion-scrub.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.533",
    "@remotion/three": "4.0.533",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.533",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "7.0.2"
  }
}
