    "routine": {
      "type": "routine-steps",
      "settings": {
        "eyebrow": "New to K-beauty?",
        "heading": "Five steps. Ten minutes. <em>All yours.</em>",
        "text": "Cleanse, tone, treat, moisturise, protect. The famous Korean routine, made easy, with a pick for every step.",
        "link_label": "Read the routine guide",
        "link_url": "shopify://pages/k-beauty",
        "script": "",
        "wash": true,
        "ampm": true,
        "evening_heading": "Four steps tonight. <em>Then sleep.</em>",
        "evening_text": "Cleanse, tone, treat, moisturise. Your sunscreen takes the night off."
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "name": "Cleanse",
            "text": "A gentle, low-foam cleanser takes off sunscreen, salt and the whole day, without that tight feeling after.",
            "product": "beplain-mung-bean-ph-balanced-cleansing-foam"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "name": "Tone",
            "text": "Forget the alcohol splash you remember. A Korean toner is a thin layer of water and calming extracts that puts moisture back.",
            "product": "round-lab-1025-dokdo-toner"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "name": "Treat",
            "text": "The step that does the heavy lifting. Pick a serum for one job: hydrate, brighten or calm. Island skin? Start with hydration.",
            "product": "torriden-dive-in-low-molecular-hyaluronic-acid-serum"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "name": "Moisturise",
            "text": "Seal it all in. A cream looks after the skin barrier that sun, salt and aircon wear down.",
            "product": "dr-althea-345-relief-cream"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "name": "Protect",
            "text": "Sunscreen every morning, rain or shine. The one step you never skip.",
            "product": "beauty-of-joseon-relief-sun-rice-niacinamide",
            "when": "am"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3",
        "step_4",
        "step_5"
      ]
