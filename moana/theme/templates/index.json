      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How much is delivery?",
            "answer": "<p>Rs 100 anywhere in Mauritius, and free when your order is over Rs 1,500.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Usually 1 to 3 working days.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Can I collect my order instead?",
            "answer": "<p>Yes, in Mon Gout. Message us on WhatsApp or by email and we'll find a time that works for you.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How do I pay?",
            "answer": "<p>By card at checkout. Payments go through MIPS, so we never see your full card number.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Are the products authentic?",
            "answer": "<p>Always. Every product page shows the full ingredient list, so you can check it against the brand's own.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Can I return a product?",
            "answer": "<p>Yes, if it's unopened and in its original packaging, within seven days of delivery. Opened skincare can't come back for hygiene reasons, unless it's faulty or not what you ordered. All the details are on <a href=\"/pages/delivery\">Delivery &amp; returns</a>.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "How do I try something new?",
            "answer": "<p>Patch test first: a little on your inner arm or behind your ear, then wait a day. Our product info is not medical advice.</p>"
          }
        }
      },
