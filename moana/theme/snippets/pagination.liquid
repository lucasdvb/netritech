{%- comment -%} Param: paginate. {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" rel="prev" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" aria-label="{{ 'general.page_n' | t: page: part.title }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span aria-current="page" aria-label="{{ 'general.page_n' | t: page: part.title }}">{{ part.title }}</span>
      {%- else -%}
        <span>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" rel="next" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
