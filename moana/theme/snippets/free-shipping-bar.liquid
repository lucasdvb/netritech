{%- comment -%}
  Progress to free delivery. The threshold is a theme setting and must match the shipping rate in
  Settings > Shipping and delivery (today: free above Rs 1,500, Rs 100 otherwise).
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign total = cart.total_price
  assign remaining = threshold | minus: total
  assign pct = 0
  if threshold > 0
    assign pct = total | times: 100 | divided_by: threshold
  endif
  if pct > 100
    assign pct = 100
  endif
-%}
{%- if threshold > 0 -%}
<div class="ship-bar{% if total > threshold %} is-done{% endif %}">
  {%- if total > threshold -%}
    <p>{% render 'icon', name: 'check' %} {{ 'cart.free_delivery_unlocked' | t }}</p>
  {%- else -%}
    {%- assign threshold_money = threshold | money -%}
    {%- assign remaining_money = remaining | money -%}
    {%- comment -%} Free delivery starts strictly above the threshold, hence "more than". {%- endcomment -%}
    {%- if remaining == 0 -%}
      <p>{{ 'cart.free_delivery_almost_html' | t: threshold: threshold_money }}</p>
    {%- else -%}
      <p>{{ 'cart.free_delivery_progress_html' | t: remaining: remaining_money, threshold: threshold_money }}</p>
    {%- endif -%}
  {%- endif -%}
  <div class="ship-bar__track" role="progressbar" aria-label="{{ 'cart.free_delivery_label' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}"><div class="ship-bar__fill" style="--p: {{ pct }}"></div></div>
</div>
{%- endif -%}
