{%- comment -%}
  Product card, after Cult Beauty: photo with a wishlist heart, the name, one outlined badge, the price in bold,
  and a full-width ADD TO BAG.
  Params: product (required), index (reveal stagger), sizes, eager (bool, first row above the fold),
          heading (h2|h3, default h3), quick_add (default true).
  Badges come from real data only: sold out, a compare-at price (shown as % off), low stock (under the theme
  threshold), or NEW IN for products published in the last 60 days.
  Add to bag is a plain POST to /cart/add, so it works with JavaScript off; theme.js turns it into an AJAX add
  that opens the bag drawer. Products with real options link to the product page instead.
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign img = product.featured_media.preview_image
  assign alt_img = product.media[1].preview_image
  assign img_sizes = sizes | default: '(min-width: 1200px) 23vw, (min-width: 750px) 31vw, 47vw'
  assign h = heading | default: 'h3'
  assign show_quick = true
  if quick_add == false
    assign show_quick = false
  endif
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif

  assign badge = ''
  assign badge_class = ''
  if product.available == false
    assign badge = 'products.sold_out' | t
    assign badge_class = ' badge--muted'
  elsif variant.compare_at_price > variant.price
    assign pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
    assign badge = 'products.percent_off' | t: pct: pct
  else
    assign low = settings.low_stock_threshold | default: 0
    if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= low
      assign badge = 'products.low_stock' | t: count: variant.inventory_quantity
    else
      assign now_s = 'now' | date: '%s' | plus: 0
      assign pub_s = product.published_at | default: product.created_at | date: '%s' | plus: 0
      assign age = now_s | minus: pub_s
      if age < 5184000
        assign badge = 'products.new_in' | t
      endif
    endif
  endif
-%}
<article class="card reveal" style="--i: {{ index | default: 0 | modulo: 4 }}">
  <div class="card__media{% if alt_img %} has-alt{% endif %}">
    {%- if img -%}
      {{- img | image_url: width: 900 | image_tag:
          widths: '240, 360, 480, 600, 750, 900',
          sizes: img_sizes,
          loading: loading,
          class: 'card__img--main',
          alt: img.alt | default: product.title
      -}}
      {%- if alt_img -%}
        {{- alt_img | image_url: width: 900 | image_tag: widths: '360, 480, 600, 750, 900', sizes: img_sizes, loading: 'lazy', class: 'card__img--alt', alt: '' -}}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <button class="card__heart" type="button" data-wishlist-toggle="{{ product.handle }}" aria-pressed="false">
    {%- render 'icon', name: 'heart' -%}<span class="sr-only">{{ 'wishlist.save' | t: title: product.title }}</span>
  </button>
  <div class="card__body">
    <{{ h }} class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></{{ h }}>
    {%- if badge != blank -%}<p class="badge{{ badge_class }}">{{ badge }}</p>{%- endif -%}
  </div>
  <p class="card__price">
    {%- if product.price_varies -%}
      {{ 'products.from_price' | t: price: product.price_min | money }}
    {%- else -%}
      {%- if variant.compare_at_price > variant.price -%}<s><span class="sr-only">{{ 'products.regular_price' | t }}</span>{{ variant.compare_at_price | money }}</s> <span class="sr-only">{{ 'products.sale_price' | t }}</span>{%- endif -%}
      {{ variant.price | money }}
    {%- endif -%}
  </p>
  <div class="card__buy">
    {%- if show_quick and product.available and product.has_only_default_variant -%}
      {%- form 'product', product, class: 'card__form', data-product-form: '', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="btn btn--full card__btn" type="submit" name="add">{{ 'products.add_to_cart' | t }}<span class="sr-only">: {{ product.title }}</span></button>
      {%- endform -%}
    {%- elsif product.available -%}
      <a class="btn btn--full card__btn" href="{{ product.url }}">{{ 'products.choose' | t }}<span class="sr-only">: {{ product.title }}</span></a>
    {%- else -%}
      <span class="btn btn--full btn--secondary card__btn" aria-disabled="true">{{ 'products.sold_out' | t }}</span>
    {%- endif -%}
  </div>
</article>
