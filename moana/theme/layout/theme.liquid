<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32">
  <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

  {%- comment -%} Only the two faces every page paints above the fold are preloaded. {%- endcomment -%}
  {{ 'raleway-normal-400-700-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'instrument-serif-normal-400-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% render 'fonts' %}
  {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

  {% render 'meta-tags' %}
  {% render 'structured-data' %}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}{% if template.suffix != blank %} template-{{ template.name }}--{{ template.suffix | handle }}{% endif %}">
  <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>
  <div id="a11y-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

  {% sections 'header-group' %}

  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}
  {% render 'search-modal' %}
  <div class="overlay" data-overlay></div>
  <div class="toast" data-toast role="status" aria-live="polite" hidden></div>

  <script>
    window.theme = {
      locale: {{ request.locale.iso_code | json }},
      moneyFormat: {{ shop.money_format | json }},
      freeShippingThreshold: {{ settings.free_shipping_threshold | default: 0 | times: 100 | json }},
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }},
        recommendations: {{ routes.product_recommendations_url | json }}
      },
      strings: {
        added: {{ 'cart.toast_added' | t | json }},
        addError: {{ 'cart.error_add' | t | json }},
        updateError: {{ 'cart.error_update' | t | json }},
        capped: {{ 'cart.error_capped' | t | json }},
        cartCount: {{ 'cart.count_status' | t: count: '__COUNT__' | json }},
        searchNone: {{ 'search.no_results_short' | t | json }},
        addToCart: {{ 'products.add_to_cart' | t | json }},
        soldOut: {{ 'products.sold_out' | t | json }},
        contactPrefill: {{ 'contact.prefill' | t: range: '__RANGE__' | json }},
        loading: {{ 'general.loading' | t | json }},
        wishlistAdded: {{ 'wishlist.added' | t | json }},
        wishlistRemoved: {{ 'wishlist.removed' | t | json }},
        slideN: {{ 'general.slide_n' | t: n: '__N__' | json }},
        readMore: {{ 'collections.read_more' | t | json }},
        readLess: {{ 'collections.read_less' | t | json }}
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
