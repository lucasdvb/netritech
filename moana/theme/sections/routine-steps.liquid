<section class="section routine{% if section.settings.wash %} section--wash routine--glass{% endif %}" aria-labelledby="rt-{{ section.id }}"{% if section.settings.ampm %} data-routine-ampm{% endif %}>
  {%- if section.settings.wash -%}
    {%- comment -%} GetLayers "Feather" wash, tinted to Spring, Khaki Linen and Sage. The steps sit on it as glass. {%- endcomment -%}
    <div class="wash" aria-hidden="true"><canvas data-wash data-bg="#f6f8f0" data-a="#eef1e4" data-b="#d1d9be" data-c="#d6d2bf" data-d="#bcc09b"></canvas></div>
    <script src="{{ 'wash.js' | asset_url }}" defer></script>
  {%- endif -%}
  <div class="page-width routine__grid">
    <div class="routine__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="t-label">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="t-h1" data-lines id="rt-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="t-lead" data-routine-text>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.ampm -%}
        {%- comment -%} the evening copy, swapped in by theme.js when the switch says evening {%- endcomment -%}
        <template data-routine-copy>
          <span data-am-heading>{{ section.settings.heading }}</span><span data-pm-heading>{{ section.settings.evening_heading | default: section.settings.heading }}</span>
          <span data-am-text>{{ section.settings.text }}</span><span data-pm-text>{{ section.settings.evening_text | default: section.settings.text }}</span>
        </template>
        {%- render 'ampm-toggle' -%}
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="btn btn--secondary" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
      {%- if section.settings.script != blank -%}<p class="t-script" aria-hidden="true">{{ section.settings.script }}</p>{%- endif -%}
    </div>
    <ol class="routine__steps" role="list">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign when = block.settings.when | default: 'both' -%}
        <li class="step reveal"{% if section.settings.wash %} data-sheen{% endif %} data-when="{{ when }}"{% if section.settings.ampm and when == 'pm' %} hidden{% endif %} {{ block.shopify_attributes }}>
          <span class="step__num" aria-hidden="true"></span>
          <div class="step__body">
            <h3 class="t-h3">{{ block.settings.name }}</h3>
            {%- if block.settings.text != blank -%}<p class="t-soft">{{ block.settings.text }}</p>{%- endif -%}
            {%- if p != blank -%}
              <div class="step__product">
                <a class="step__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                  {{- p.featured_media.preview_image | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '84px', loading: 'lazy', alt: '' -}}
                </a>
                <div class="step__info">
                  <p class="card__vendor">{{ p.vendor }}</p>
                  <a class="step__name" href="{{ p.url }}">{{ p.title }}</a>
                  {%- render 'price', product: p -%}
                </div>
                {%- if p.available and p.has_only_default_variant -%}
                  {%- form 'product', p, class: 'step__form', data-product-form: '', novalidate: 'novalidate' -%}
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button class="btn btn--small" type="submit" name="add" aria-label="{{ 'products.add_named' | t: title: p.title | escape }}">{% render 'icon', name: 'plus' %}<span class="hide-mobile">{{ 'products.add' | t }}</span></button>
                  {%- endform -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
.routine { position: relative; isolation: isolate; }
.routine .wash { z-index: -1; }
.routine__grid { display: grid; gap: var(--s-7); }
.routine__intro > * + * { margin-top: var(--s-5); }
.routine__intro .t-script { margin-top: var(--s-6); }
.routine__steps { counter-reset: step; }
.step:not([hidden]) { counter-increment: step; }
.step__num::before { content: counter(step, decimal-leading-zero); }
.step { display: grid; grid-template-columns: 3.25rem 1fr; gap: var(--s-4); padding-block: var(--s-6); border-top: 1px solid var(--line); }
.step:last-child { border-bottom: 1px solid var(--line); }
.step__num { font: var(--w-light) var(--fs-2xl)/1 var(--f-body); color: var(--c-sage); font-variant-numeric: lining-nums; }
.section--wash .step__num { color: var(--c-forest); opacity: .55; }
.step__body > * + * { margin-top: var(--s-3); }
.step__body .t-soft { max-width: 36rem; }
.step__product { display: grid; grid-template-columns: 72px 1fr auto; align-items: center; gap: var(--s-4); margin-top: var(--s-5) !important; padding: var(--s-3); border-radius: var(--r); background: var(--c-white); }
.step__img { display: block; aspect-ratio: 1; border-radius: var(--r-sm); background: var(--tile); overflow: hidden; }
.step__img img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; padding: 8%; }
.step__info { display: grid; gap: 2px; min-width: 0; }
.step__name { font: var(--w-regular) var(--fs-md)/1.25 var(--f-body); }
.step__name:hover { color: var(--brand); }
.step__form .btn { gap: .4rem; }
.step__form .btn svg { width: 14px; height: 14px; }
@media (max-width: 749px) { .step__form .btn { width: 44px; min-height: 44px; padding: 0; border-radius: 50%; } }
/* glass steps over the wash */
.routine--glass .routine__steps { display: grid; gap: var(--s-3); }
.routine--glass .step { padding: var(--s-5); border: 1px solid rgba(255,255,255,.7); border-radius: var(--r); background: rgba(255,255,255,.5);
  -webkit-backdrop-filter: blur(22px) saturate(1.4); backdrop-filter: blur(22px) saturate(1.4);
  box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 24px 60px -40px rgba(33,39,33,.4); }
.routine--glass .step:last-child { border-bottom: 1px solid rgba(255,255,255,.7); }
.routine--glass .step__product { background: rgba(255,255,255,.78); }
@media (max-width: 749px) {
  .routine--glass .step { grid-template-columns: 1fr; gap: var(--s-2); padding: var(--s-5) var(--s-4); }
  .routine--glass .step__num { font-size: var(--fs-xl); }
  .routine--glass .step__product { grid-template-columns: 64px 1fr auto; gap: var(--s-3); }
}
@media (min-width: 990px) {
  .routine--glass .step { padding: var(--s-6) var(--s-6) var(--s-6) var(--s-5); }
  .routine__grid { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(3rem, 7vw, 8rem); align-items: start; }
  .routine__intro { position: sticky; top: calc(var(--header-h) + var(--s-7)); }
  .step { grid-template-columns: 5rem 1fr; padding-block: var(--s-7); }
  .step__num { font-size: var(--fs-3xl); }
}
/* scroll: a hairline beside the steps fills as you read down them, and each step number
   brightens as its card reaches the middle of the screen. */
.routine__steps { position: relative; }
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .routine__steps::before, .routine__steps::after { content: ""; position: absolute; top: 0; bottom: 0; left: calc(var(--gutter) * -.5); width: 1px; background: var(--line); pointer-events: none; }
    .routine__steps::after { background: var(--c-forest); transform-origin: 50% 0; scale: 1 0;
      animation: sx-grow-y linear both; animation-timeline: view(); animation-range: cover 18% contain 100%; }
    @keyframes sx-grow-y { to { scale: 1 1; } }
    .section--wash .step__num { animation: step-on linear both; animation-timeline: view(); animation-range: entry 40% cover 45%; }
    @keyframes step-on { from { opacity: .2; translate: 0 .25em; } to { opacity: .9; translate: 0 0; } }
  }
}
@media (min-width: 990px) { .routine__steps::before, .routine__steps::after { left: calc(clamp(3rem, 7vw, 8rem) * -.5); } }
/* morning / evening: the switch re-tints the section to dusk, steps that belong to the other half of
   the day step out (sunscreen sleeps at night), and the heading swaps (theme.js). */
.routine .ampm { margin-top: var(--s-5); }
.routine, .routine .step, .routine .step__product, .routine .t-soft, .routine .t-lead, .routine .step__num { transition: color 600ms var(--ease), background-color 600ms var(--ease), border-color 600ms var(--ease); }
.step.is-leaving { opacity: 0; translate: 0 -8px; transition: opacity 260ms var(--ease), translate 260ms var(--ease); }
.step.is-entering { animation: step-enter 520ms var(--ease) both; }
@keyframes step-enter { from { opacity: 0; translate: 0 12px; } to { opacity: 1; translate: 0 0; } }
.routine.is-evening { color: var(--c-white); background-color: #262d26; }
.routine.is-evening h2, .routine.is-evening h3, .routine.is-evening .t-h1, .routine.is-evening .t-h3 { color: var(--c-white); transition: color 600ms var(--ease); }
.routine.is-evening .t-lead, .routine.is-evening .t-soft { color: rgba(255, 255, 255, .78); }
.routine.is-evening .t-label { color: var(--c-mist); }
.routine.is-evening em { color: #d1d9be; }
.routine.is-evening .btn--secondary { --btn-line: rgba(255, 255, 255, .7); color: var(--c-white); background: transparent; }
.routine--glass.is-evening .step { background: rgba(33, 39, 33, .42); border-color: rgba(255, 255, 255, .14); box-shadow: 0 1px 0 rgba(255,255,255,.08) inset, 0 24px 60px -40px rgba(0,0,0,.6); }
.routine.is-evening .step__product { background: rgba(255, 255, 255, .08); }
.routine.is-evening .step__name, .routine.is-evening .price { color: var(--c-white); }
.routine.is-evening .card__vendor { color: var(--c-mist); }
.routine.is-evening .step__num { color: #d1d9be; opacity: .9; }
.routine.is-evening .step__img { background: rgba(255, 255, 255, .9); }
.routine.is-evening .routine__steps::before { background: rgba(255, 255, 255, .16); }
.routine.is-evening .routine__steps::after { background: #d1d9be; }
@media (prefers-reduced-motion: reduce) { .step.is-entering { animation: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Routine steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "New to K-beauty?" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Five steps. Ten minutes. <em>All yours.</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Cleanse, tone, treat, moisturise, protect. The famous Korean routine, made easy, with a pick for every step." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the routine guide" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "text", "id": "script", "label": "Script accent (Pinyon Script)", "info": "Use once per page at most." },
    { "type": "checkbox", "id": "wash", "label": "Watercolour wash background with glass steps", "default": true },
    { "type": "checkbox", "id": "ampm", "label": "Morning / evening switch", "info": "Opens on evening after 5pm Mauritius time. Steps set to Morning or Evening show only then.", "default": true },
    { "type": "inline_richtext", "id": "evening_heading", "label": "Evening heading", "default": "Four steps tonight. <em>Then sleep.</em>" },
    { "type": "textarea", "id": "evening_text", "label": "Evening text", "default": "Cleanse, tone, treat, moisturise. Your sunscreen takes the night off." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "name", "label": "Step name", "default": "Cleanse" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "select", "id": "when", "label": "When", "default": "both", "options": [ { "value": "both", "label": "Morning and evening" }, { "value": "am", "label": "Morning only" }, { "value": "pm", "label": "Evening only" } ] }
    ] }
  ],
  "presets": [{ "name": "Routine steps" }]
}
{% endschema %}
