{%- liquid
  assign per_page = section.settings.per_page
  assign tag_handle = current_tags.first | handle
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_count = 0
  for f in collection.filters
    assign active_count = active_count | plus: f.active_values.size
    if f.type == 'price_range'
      if f.min_value.value != nil or f.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign is_soon = false
  if collection.all_products_count == 0 and current_tags == blank
    assign is_soon = true
  endif
-%}

<div class="page-width">{%- render 'breadcrumbs' -%}</div>

<section class="plp" data-collection data-section-id="{{ section.id }}">
  <header class="page-width plp__head">
    <div class="plp__title-wrap">
      {%- if current_tags -%}
        <p class="t-label">{{ collection.title }}</p>
        <h1 class="t-h1">{{ current_tags | join: ' · ' }}</h1>
      {%- else -%}
        {%- if section.settings.show_label -%}<p class="t-label">{{ 'collections.label' | t }}</p>{%- endif -%}
        <h1 class="t-h1">{{ collection.title }}</h1>
      {%- endif -%}
      {%- if collection.description != blank and current_tags == blank -%}
        <div class="t-lead plp__desc">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </header>

  {%- if is_soon -%}
    <div class="page-width plp__soon">
      <div class="plp__soon-card">
        <p class="t-label">{{ 'collections.soon_label' | t }}</p>
        <h2 class="t-h3">{{ 'collections.soon_heading' | t: title: collection.title }}</h2>
        <p class="t-soft">{{ 'collections.soon_text' | t }}</p>
        <div class="cluster">
          <a class="btn" href="{{ pages['contact'].url | default: '/pages/contact' }}?range={{ collection.title | url_encode }}">{{ 'collections.soon_cta' | t }}</a>
          <a class="btn btn--secondary" href="{{ collections['skincare'].url }}">{{ 'collections.soon_browse' | t }}</a>
        </div>
      </div>
      {%- assign meanwhile = section.settings.soon_collection | default: collections['new'] -%}
      {%- if meanwhile.products_count > 0 -%}
        <div class="plp__meanwhile">
          <h2 class="t-h3">{{ 'collections.meanwhile' | t }}</h2>
          <ul class="product-grid product-grid--4" role="list">
            {%- for product in meanwhile.products limit: 4 -%}<li>{%- render 'product-card', product: product, index: forloop.index0 -%}</li>{%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  {%- else -%}

  {%- comment -%} Quick routes: sub-categories (section blocks) and concern / skin-type tags. {%- endcomment -%}
  {%- liquid
    comment
      Sub-category pills show on the parent (e.g. Skincare) and on each sub-category, so shoppers can hop
      sideways; brand and other collections skip them.
    endcomment
    assign show_subs = false
    if collection.handle == section.settings.parent.handle
      assign show_subs = true
    endif
    for block in section.blocks
      if block.settings.collection.handle == collection.handle
        assign show_subs = true
      endif
    endfor
    assign parent = section.settings.parent | default: collection
  -%}
  {%- if show_subs or section.settings.show_tag_pills -%}
    <div class="page-width plp__routes">
      {%- if show_subs and section.blocks.size > 0 -%}
        <nav class="pill-row" aria-label="{{ 'collections.categories' | t }}">
          <a class="pill" href="{{ parent.url }}"{% if collection.handle == parent.handle and current_tags == blank %} aria-current="page"{% endif %}>{{ 'collections.all' | t }} <small>{{ parent.all_products_count }}</small></a>
          {%- for block in section.blocks -%}
            {%- assign sub = block.settings.collection -%}
            {%- if sub != blank -%}
              <a class="pill" href="{{ sub.url }}"{% if sub.handle == collection.handle %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label | default: sub.title }} <small>{{ sub.products_count }}</small></a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
      {%- if section.settings.show_tag_pills -%}
        <nav class="pill-row plp__tags" aria-label="{{ 'collections.concerns' | t }}">
          <span class="plp__tags-label t-label">{{ 'collections.refine' | t }}</span>
          {%- render 'tag-counts', source: collection, tags: settings.concern_tags, style: 'pills', current: tag_handle -%}
        </nav>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- paginate collection.products by per_page -%}
  <div class="page-width" id="plp-results" data-results>
    <div class="plp__toolbar">
      <p class="t-small t-soft" role="status">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
      <div class="plp__tools">
        <button class="pill plp__filter-btn" type="button" data-drawer-open="filter-drawer" aria-controls="filter-drawer" aria-expanded="false">
          {%- render 'icon', name: 'filter' -%}{{ 'collections.filter' | t }}{% if active_count > 0 %} <small>({{ active_count }})</small>{% endif %}
        </button>
        <form class="plp__sort" method="get" action="{{ collection.url }}" data-sort-form>
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}
            {%- if f.type == 'price_range' -%}
              {%- if f.min_value.value != nil -%}<input type="hidden" name="{{ f.min_value.param_name }}" value="{{ f.min_value.value }}">{%- endif -%}
              {%- if f.max_value.value != nil -%}<input type="hidden" name="{{ f.max_value.param_name }}" value="{{ f.max_value.value }}">{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <label class="sr-only" for="sort-{{ section.id }}">{{ 'collections.sort_by' | t }}</label>
          <select class="select plp__sort-select" id="sort-{{ section.id }}" name="sort_by" data-sort-select>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
          <noscript><button class="btn btn--small" type="submit">{{ 'collections.apply' | t }}</button></noscript>
        </form>
      </div>
    </div>

    {%- if active_count > 0 -%}
      <div class="cluster plp__active" aria-label="{{ 'collections.active_filters' | t }}">
        {%- for f in collection.filters -%}
          {%- for v in f.active_values -%}
            <a class="pill pill--sm is-active" href="{{ v.url_to_remove }}" data-filter-link>{{ v.label }} {% render 'icon', name: 'close' %}<span class="sr-only">{{ 'collections.remove_filter' | t }}</span></a>
          {%- endfor -%}
          {%- if f.type == 'price_range' -%}
            {%- if f.min_value.value != nil or f.max_value.value != nil -%}
              <a class="pill pill--sm is-active" href="{{ f.url_to_remove }}" data-filter-link>{{ f.min_value.value | default: 0 | money }}–{{ f.max_value.value | default: f.range_max | money }} {% render 'icon', name: 'close' %}<span class="sr-only">{{ 'collections.remove_filter' | t }}</span></a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <a class="link" href="{{ collection.url }}{% if current_tags %}/{{ tag_handle }}{% endif %}?sort_by={{ sort_by }}" data-filter-link>{{ 'collections.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid product-grid--4 plp__grid" role="list">
        {%- for product in collection.products -%}
          {%- liquid
            assign eager_img = false
            if forloop.index <= 2
              assign eager_img = true
            endif
          -%}
          <li>{%- render 'product-card', product: product, index: forloop.index0, eager: eager_img, heading: 'h2' -%}</li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- else -%}
      <div class="plp__empty">
        <h2 class="t-h3">{{ 'collections.no_match' | t }}</h2>
        <p class="t-soft">{{ 'collections.no_match_text' | t }}</p>
        <a class="btn btn--secondary" href="{{ collection.url }}" data-filter-link>{{ 'collections.clear_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Filter drawer: Shopify storefront filters (Search & Discovery). Works as a plain GET form without JS. {%- endcomment -%}
  <div class="drawer filter-drawer" id="filter-drawer" role="dialog" aria-modal="true" aria-labelledby="filter-title-{{ section.id }}" tabindex="-1" data-filter-drawer>
    <form class="filter-form" method="get" action="{{ collection.url }}{% if current_tags %}/{{ tag_handle }}{% endif %}" data-filter-form style="display:contents">
      <input type="hidden" name="sort_by" value="{{ sort_by }}">
      <div class="drawer__head">
        <h2 class="drawer__title" id="filter-title-{{ section.id }}">{{ 'collections.filter' | t }}</h2>
        <button class="icon-btn" type="button" data-drawer-close>{%- render 'icon', name: 'close' -%}<span class="sr-only">{{ 'general.close' | t }}</span></button>
      </div>
      <div class="drawer__body">
        {%- if collection.filters.size == 0 -%}
          <p class="t-soft t-small">{{ 'collections.no_filters' | t }}</p>
        {%- endif -%}
        <div class="accordion">
          {%- for f in collection.filters -%}
            <details class="accordion__item"{% if f.active_values.size > 0 or forloop.index <= 4 %} open{% endif %}>
              <summary><span>{{ f.label }}{% if f.active_values.size > 0 %} <small class="t-soft">({{ f.active_values.size }})</small>{% endif %}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
              <div class="accordion__body">
                {%- case f.type -%}
                  {%- when 'price_range' -%}
                    <div class="filter-price">
                      <div class="field"><label class="field__label" for="pmin-{{ section.id }}">{{ 'collections.from' | t }}</label>
                        <input class="input" id="pmin-{{ section.id }}" type="number" inputmode="numeric" min="0" max="{{ f.range_max | money_without_currency | remove: ',' }}" name="{{ f.min_value.param_name }}" value="{% if f.min_value.value != nil %}{{ f.min_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="0"></div>
                      <div class="field"><label class="field__label" for="pmax-{{ section.id }}">{{ 'collections.to' | t }}</label>
                        <input class="input" id="pmax-{{ section.id }}" type="number" inputmode="numeric" min="0" max="{{ f.range_max | money_without_currency | remove: ',' }}" name="{{ f.max_value.param_name }}" value="{% if f.max_value.value != nil %}{{ f.max_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="{{ f.range_max | money_without_currency | remove: ',' }}"></div>
                    </div>
                  {%- else -%}
                    <ul class="filter-list" role="list">
                      {%- for v in f.values -%}
                        <li>
                          <label class="check{% if v.count == 0 and v.active == false %} is-disabled{% endif %}">
                            <input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}"{% if v.active %} checked{% endif %}{% if v.count == 0 and v.active == false %} disabled{% endif %}>
                            <span class="check__box" aria-hidden="true">{% render 'icon', name: 'check' %}</span>
                            <span class="check__label">{{ v.label }}</span>
                            <span class="check__count">{{ v.count }}</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>
      <div class="drawer__foot filter-form__foot">
        <a class="btn btn--secondary" href="{{ collection.url }}{% if current_tags %}/{{ tag_handle }}{% endif %}?sort_by={{ sort_by }}" data-filter-link>{{ 'collections.clear_all' | t }}</a>
        <button class="btn" type="submit" data-drawer-close>{{ 'collections.show_results' | t }}</button>
      </div>
    </form>
  </div>
  {%- endpaginate -%}
  {%- endif -%}
</section>

{% stylesheet %}
.plp { padding-bottom: var(--section); }
.plp__head { padding-block: var(--s-5) var(--s-6); }
.plp__title-wrap > * + * { margin-top: var(--s-3); }
.plp__desc { margin-top: var(--s-4) !important; }
.plp__routes { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); }
.plp__routes .pill-row { margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
.plp__tags { align-items: center; }
.plp__tags-label { flex: none; padding-right: var(--s-2); }
.plp__toolbar { position: sticky; top: var(--header-h); z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding-block: var(--s-3); margin-bottom: var(--s-5); background: rgba(255,255,255,.96); border-bottom: 1px solid var(--line); }
.plp__tools { display: flex; align-items: center; gap: var(--s-2); }
.plp__filter-btn svg { width: 18px; height: 18px; flex: none; }
.plp__toolbar > p { white-space: nowrap; }
@media (max-width: 599px) {
  .plp__toolbar { flex-wrap: wrap; gap: var(--s-2); }
  .plp__toolbar > p { width: 100%; }
  .plp__tools { width: 100%; }
  .plp__filter-btn { flex: 1; justify-content: center; }
  .plp__sort { flex: 1.3; min-width: 0; }
  .plp__sort-select { width: 100%; min-width: 0; max-width: 100%; padding-right: 2.25rem; background-position: right .75rem center; text-overflow: ellipsis; }
  .plp__tools { min-width: 0; }
  .plp__filter-btn { padding: 0 .75rem; }
}
.plp__sort-select { min-height: 40px; width: auto; border-radius: var(--r-pill); font-size: var(--fs-small); font-weight: 500; padding-left: 1rem; }
.plp__active { margin-bottom: var(--s-5); gap: var(--s-2); }
.plp__active .pill svg { width: 12px; height: 12px; }
.plp__soon-card .cluster { margin-top: var(--s-2); }
.plp__meanwhile { margin-top: var(--section); }
.plp__meanwhile .t-h3 { margin-bottom: var(--s-6); }
.plp[aria-busy="true"] .plp__grid { opacity: .4; transition: opacity var(--t) var(--ease); }
.filter-list { display: grid; gap: 2px; }
.check { display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: var(--s-3); min-height: 44px; cursor: pointer; color: var(--ink); }
.check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.check__box { width: 22px; height: 22px; border: 1px solid var(--line-strong); border-radius: 6px; display: grid; place-items: center; transition: background-color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease); }
.check__box svg { width: 14px; height: 14px; color: #fff; opacity: 0; }
.check input:checked + .check__box { background: var(--c-forest); border-color: var(--c-forest); }
.check input:checked + .check__box svg { opacity: 1; }
.check input:focus-visible + .check__box { outline: 2px solid var(--focus); outline-offset: 2px; }
.check__count { font-size: var(--fs-xs); color: var(--ink-soft); }
.check.is-disabled { opacity: .4; cursor: not-allowed; }
.filter-price { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
.filter-form__foot { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--s-3); }
.filter-form__foot .btn { padding-inline: 1rem; }
@media (min-width: 990px) { .plp__head { padding-block: var(--s-6) var(--s-7); } .plp__routes .pill-row { margin-inline: 0; padding-inline: 0; flex-wrap: wrap; overflow: visible; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "collection", "id": "parent", "label": "Parent collection for sub-category pills", "info": "Pills show on this collection and on each sub-category below." },
    { "type": "checkbox", "id": "show_tag_pills", "label": "Show concern shortcuts", "default": true },
    { "type": "checkbox", "id": "show_label", "label": "Show 'Collection' label", "default": false },
    { "type": "collection", "id": "soon_collection", "label": "Products to show on empty 'coming soon' collections" }
  ],
  "blocks": [
    { "type": "sub", "name": "Sub-category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Label override" }
    ] }
  ]
}
{% endschema %}
