<section class="section section--tight cat-rail" aria-labelledby="cat-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="t-label">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="t-h2" id="cat-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <div class="rail-controls hide-mobile" data-rail-controls="cat-list-{{ section.id }}">
        <button type="button" data-rail-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" data-rail-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>
    <ul class="cat-rail__list" id="cat-list-{{ section.id }}" role="list" data-rail>
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          if c == blank
            continue
          endif
          assign tile = block.settings.image | default: c.image
          assign packshot = false
          if tile == blank
            assign tile = c.products.first.featured_media.preview_image
            assign packshot = true
          endif
          assign label = block.settings.label | default: c.title
        -%}
        <li class="reveal" style="--i: {{ forloop.index0 | modulo: 6 }}" {{ block.shopify_attributes }}>
          <a class="cat-tile" href="{{ c.url }}">
            <span class="cat-tile__media media{% if packshot %} media--contain{% endif %}">
              {%- if tile -%}{{ tile | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 1200px) 12vw, (min-width: 750px) 22vw, 40vw', loading: 'lazy', alt: '' }}{%- endif -%}
            </span>
            <span class="cat-tile__name">{{ label }}</span>
            <span class="cat-tile__count">{{ 'collections.product_count' | t: count: c.products_count }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.cat-rail__list { display: grid; grid-auto-flow: column; grid-auto-columns: 40%; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
.cat-rail__list::-webkit-scrollbar { display: none; }
.cat-rail__list > li { scroll-snap-align: start; }
@media (min-width: 750px) { .cat-rail__list { grid-auto-columns: 22%; } }
@media (min-width: 1200px) { .cat-rail__list { grid-auto-columns: calc((100% - 7 * var(--gap)) / 8); margin-inline: 0; padding-inline: 0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Category rail",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every step of the routine" }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Label override" },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Defaults to the collection image, then its first product." }
    ] }
  ],
  "presets": [{ "name": "Category rail" }]
}
{% endschema %}
