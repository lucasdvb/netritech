{%- comment -%}
  Service bar, as on Cult Beauty: up to four promises with an icon, on First Frost. On phones one shows at a
  time and they take turns (paused on hover/focus, and still under reduced motion).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="usp" role="region" aria-label="{{ 'header.announcement' | t }}" data-usp>
  <ul class="page-width usp__list" role="list">
    {%- for block in section.blocks -%}
      <li class="usp__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a class="usp__link" href="{{ block.settings.link }}">{%- else -%}<span class="usp__link">{%- endif -%}
          {%- render 'icon', name: block.settings.icon -%}<span>{{ block.settings.text }}</span>
        {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- endif -%}

{% stylesheet %}
  .usp { background: var(--c-frost); border-bottom: 1px solid var(--line); }
  .usp__list { position: relative; display: grid; height: 40px; }
  .usp__item { grid-area: 1 / 1; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity 400ms var(--ease), transform 400ms var(--ease), visibility 0s linear 400ms; }
  .usp__item.is-active { opacity: 1; visibility: visible; transform: none; transition: opacity 400ms var(--ease), transform 400ms var(--ease); }
  .usp__link { display: inline-flex; align-items: center; gap: .6rem; font: var(--w-medium) var(--fs-xs)/1.3 var(--f-body); letter-spacing: .02em; color: var(--ink); white-space: nowrap; }
  a.usp__link:hover span { text-decoration: underline; text-underline-offset: 3px; }
  .usp__link svg { width: 20px; height: 20px; flex: none; }
  @media (min-width: 990px) {
    .usp__list { display: flex; justify-content: center; gap: clamp(1.5rem, 3vw, 3rem); height: 44px; }
    .usp__item, .usp__item.is-active { opacity: 1; visibility: visible; transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Service bar",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "usp",
      "name": "Promise",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Delivery" }, { "value": "list", "label": "Ingredients" }, { "value": "mail", "label": "Email" },
          { "value": "sparkle", "label": "Sparkle" }, { "value": "heart", "label": "Heart" }, { "value": "gift", "label": "Gift" },
          { "value": "leaf", "label": "Leaf" }, { "value": "card", "label": "Card" }, { "value": "pin", "label": "Pin" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Delivered in 1 to 3 working days" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Service bar", "blocks": [{ "type": "usp" }] }]
}
{% endschema %}
