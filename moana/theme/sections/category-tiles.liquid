{%- comment -%} "SHOP BY CATEGORY" (Cult Beauty): square tiles with an uppercase label; a swipe rail on phones. {%- endcomment -%}
<section class="section section--tight cat-t" aria-labelledby="ct-{{ section.id }}">
  <div class="page-width">
    <h2 class="t-title" id="ct-{{ section.id }}">{{ section.settings.heading }}</h2>
    <div class="carousel cat-t__wrap" data-carousel>
      <ul class="carousel__track cat-t__track" data-carousel-track role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign label = block.settings.label | default: c.title
            assign url = block.settings.link | default: c.url
            assign img = block.settings.image | default: c.featured_image | default: c.products.first.featured_media.preview_image
          -%}
          <li class="cat-t__item reveal" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <a class="cat-t__tile" href="{{ url }}">
              <span class="cat-t__img{% if block.settings.image == blank and c.featured_image == blank %} is-pack{% endif %}">
                {%- if img -%}{{ img | image_url: width: 500 | image_tag: widths: '250, 375, 500', sizes: '(min-width: 990px) 15vw, 40vw', loading: 'lazy', alt: '', class: 'sx-float' }}{%- endif -%}
              </span>
              <span class="cat-t__label">{{ label }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      <button class="carousel__arrow carousel__arrow--prev" type="button" data-carousel-prev>{% render 'icon', name: 'chevron-left' %}<span class="sr-only">{{ 'general.prev_slide' | t }}</span></button>
      <button class="carousel__arrow carousel__arrow--next" type="button" data-carousel-next>{% render 'icon', name: 'chevron-right' %}<span class="sr-only">{{ 'general.next_slide' | t }}</span></button>
    </div>
  </div>
</section>

{% stylesheet %}
  .cat-t .t-title { margin-bottom: var(--title-gap); }
  .cat-t__track { grid-auto-columns: calc((100% - 5 * 1.5rem) / 6); gap: 1.5rem; }
  @media (max-width: 989px) { .cat-t__track { grid-auto-columns: calc((100% - 2 * 1rem) / 3.3); gap: 1rem; } }
  @media (max-width: 749px) { .cat-t__track { grid-auto-columns: 44%; } }
  .cat-t { view-timeline: --cat block; --sx-tl: --cat; }
  .cat-t__item:nth-child(2n) .sx-float { animation-direction: reverse; }
  .cat-t__img:not(.is-pack) .sx-float { animation: none; }
  .cat-t__tile { display: grid; gap: var(--s-3); text-align: center; }
  .cat-t__img { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: var(--c-frost); }
  .cat-t__img.is-pack { background: linear-gradient(160deg, #f3f5ec, var(--c-spring)); }
  .cat-t__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .cat-t__img.is-pack img { object-fit: contain; padding: 12%; mix-blend-mode: multiply; }
  .cat-t__tile:hover .cat-t__img img { transform: scale(1.06); }
  .cat-t__label { font: var(--w-medium) var(--fs-sm)/1.3 var(--f-body); letter-spacing: .06em; text-transform: uppercase; }
  .cat-t__tile:hover .cat-t__label { text-decoration: underline; text-underline-offset: 4px; }
  .cat-t .carousel__arrow { top: 40%; }
  @media (min-width: 990px) { .cat-t .carousel__arrow { display: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "settings": [ { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Shop by category" } ],
  "max_blocks": 8,
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Label (defaults to collection title)" },
      { "type": "url", "id": "link", "label": "Link (defaults to the collection)" },
      { "type": "image_picker", "id": "image", "label": "Image" }
    ] }
  ],
  "presets": [{ "name": "Category tiles" }]
}
{% endschema %}
