<section class="section faq" aria-labelledby="faq-{{ section.id }}">
  <div class="page-width faq__grid">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="t-label">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="t-h2" data-lines id="faq-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte t-soft">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><span class="accordion__icon" aria-hidden="true"></span></summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.faq__grid { display: grid; gap: var(--s-6); }
.faq__intro > * + * { margin-top: var(--s-4); }
.faq .accordion__item > summary { font: 400 clamp(1.125rem, 1rem + .5vw, 1.375rem)/1.3 var(--f-display); letter-spacing: 0; min-height: 68px; }
@media (min-width: 990px) { .faq__grid { grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: clamp(3rem, 7vw, 8rem); } }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Good to know" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "You asked. We answered." },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How much is delivery?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Rs 100 anywhere in Mauritius, and free when your order is above Rs 1,500.</p>" }
    ] }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
