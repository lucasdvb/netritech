{%- liquid
  assign brand_name = settings.brand_name | default: shop.name
-%}
<footer class="site-footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="{{ 'logo-lockup-light.svg' | asset_url }}" alt="{{ brand_name | escape }}" width="785" height="380" loading="lazy">
        {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline }}</p>{%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading }}</h2>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul role="list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'contact' -%}
              <ul class="footer__contact" role="list">
                <li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ shop.email }}">{{ shop.email }}</a></li>
                {%- if settings.whatsapp_number != blank -%}
                  <li>{% render 'icon', name: 'whatsapp' %}<a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{{ 'general.whatsapp' | t }} {{ settings.whatsapp_display }}<span class="sr-only"> ({{ 'general.opens_new_window' | t }})</span></a></li>
                {%- endif -%}
                {%- if settings.address_street != blank -%}
                  <li>{% render 'icon', name: 'pin' %}<span>{{ settings.address_street }}, {{ settings.address_locality }}</span></li>
                {%- endif -%}
              </ul>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.legal_name | default: brand_name }}{% if settings.company_number != blank %} · {{ 'footer.brn' | t }} {{ settings.company_number }}{% endif %}</p>
      <ul role="list">
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
        {%- endfor -%}
      </ul>
      {%- if localization.available_languages.size > 1 -%}
        {%- form 'localization', class: 'footer__lang' -%}
          <span class="sr-only">{{ 'footer.language' | t }}</span>
          {%- for language in localization.available_languages -%}
            {%- unless language.iso_code == localization.language.iso_code -%}
              <button type="submit" name="language_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}">{{ language.endonym_name | capitalize }}</button>
            {%- endunless -%}
          {%- endfor -%}
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Authentic Korean skincare, chosen for island skin and delivered across Mauritius." }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] },
    { "type": "contact", "name": "Contact column", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us" }
    ] }
  ]
}
{% endschema %}
