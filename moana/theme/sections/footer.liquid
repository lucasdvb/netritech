{%- comment -%}
  Footer. Built on the GetLayers "Artist" footer composition: a quiet column row, the brand word set
  edge to edge at full width, and a hairline bar. Minimal and bold, on a green-black ground
  (--c-abyss: Pantone Black 3 C deepened towards black).
  The sign-up is Shopify's own customer form (no app): it saves the email as a customer who accepts marketing.
{%- endcomment -%}
{%- liquid
  assign brand_name = settings.brand_name | default: shop.name
-%}
<footer class="site-footer">
  <div class="page-width footer__shell">
    {%- comment -%} register 1: brand column (5) facing three quiet link columns (2 | 2 | 3) {%- endcomment -%}
    <div class="footer__row">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo"><img src="{{ 'logo-lockup-light.webp' | asset_url }}" alt="{{ brand_name | escape }}" width="900" height="436" loading="lazy"></a>
        {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}

        {%- if section.settings.show_signup -%}
          <div class="footer__signup">
            {%- if section.settings.signup_eyebrow != blank -%}<p class="footer__label" id="footer-signup-label">{{ section.settings.signup_eyebrow }}</p>{%- endif -%}
            {%- form 'customer', id: 'footer-signup', class: 'footer__form', novalidate: 'novalidate' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="footer__form-msg footer__form-msg--ok" role="status" tabindex="-1" data-focus-on-load>{% render 'icon', name: 'check' %}{% if settings.kreol %}{{ 'kreol.signup_success' | t }}{% else %}{{ 'footer.signup_success' | t }}{% endif %}</p>
              {%- else -%}
                <label class="sr-only" for="footer-email">{{ 'footer.signup_label' | t }}</label>
                <div class="line-field{% if form.errors %} is-invalid{% endif %}">
                  <input class="line-field__input" id="footer-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required
                    placeholder="{{ 'footer.signup_placeholder' | t }}" value="{{ form.email }}"
                    {% if form.errors %}aria-invalid="true" aria-describedby="footer-email-err"{% else %}aria-describedby="footer-email-note"{% endif %}>
                  <button class="line-field__btn" type="submit">{{ 'footer.signup_button' | t }}{% render 'icon', name: 'arrow-right' %}</button>
                </div>
                {%- if form.errors -%}
                  <p class="footer__form-msg footer__form-msg--error" id="footer-email-err">{% render 'icon', name: 'alert' %}{{ 'footer.signup_error' | t }}</p>
                {%- else -%}
                  <p class="footer__form-note" id="footer-email-note">{{ section.settings.signup_note }}</p>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <nav class="footer__col footer__col--{{ block.type }}" aria-labelledby="footer-h-{{ block.id }}" {{ block.shopify_attributes }}>
          <h2 class="footer__label" id="footer-h-{{ block.id }}">{{ block.settings.heading }}</h2>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <ul role="list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a class="footer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span>{{ link.title }}</span></a></li>
                {%- endfor -%}
              </ul>
            {%- when 'contact' -%}
              <ul class="footer__contact" role="list">
                <li><a class="footer__link" href="mailto:{{ shop.email }}"><span>{{ shop.email }}</span></a></li>
                {%- if settings.address_street != blank -%}
                  <li class="footer__addr"><span>{{ settings.address_street }}, {{ settings.address_locality }}</span></li>
                {%- endif -%}
              </ul>
          {%- endcase -%}
        </nav>
      {%- endfor -%}
    </div>

    {%- comment -%}
      register 2: the brand word, set edge to edge. Its size is worked out from the column width
      (container query units), so it always fits the full width and is never cropped. Each letter
      rises out of its own mask when the footer arrives. Decorative: hidden from assistive tech.
    {%- endcomment -%}
    {%- if section.settings.watermark != blank -%}
      <div class="footer__word reveal" aria-hidden="true">
        <p class="footer__word-text">
          {%- assign letters = section.settings.watermark | upcase | split: '' -%}
          {%- for l in letters -%}<span style="--l: {{ forloop.index0 }}">{{ l }}</span>{%- endfor -%}
        </p>
      </div>
    {%- endif -%}

    {%- comment -%} register 3: a hairline bar, copyright left, legal, language and credit right {%- endcomment -%}
    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.legal_name | default: brand_name }}{% if settings.company_number != blank %} · {{ 'footer.brn' | t }} {{ settings.company_number }}{% endif %}</p>
      <div class="footer__legal">
        <ul role="list">
          {%- for policy in shop.policies -%}
            <li><a class="footer__link" href="{{ policy.url }}"><span>{{ policy.title }}</span></a></li>
          {%- endfor -%}
        </ul>
        {%- if localization.available_languages.size > 1 -%}
          {%- form 'localization', class: 'footer__lang' -%}
            <span class="sr-only">{{ 'footer.language' | t }}</span>
            {%- for language in localization.available_languages -%}
              {%- unless language.iso_code == localization.language.iso_code -%}
                <button type="submit" name="language_code" value="{{ language.iso_code }}" lang="{{ language.iso_code }}">{{ language.endonym_name | capitalize }}</button>
              {%- endunless -%}
            {%- endfor -%}
          {%- endform -%}
        {%- endif -%}
        {%- if section.settings.credit_label != blank -%}
          <p class="footer__credit"><a class="footer__link" href="{{ section.settings.credit_url | default: 'https://www.disruptivedodo.mu' }}" target="_blank" rel="noopener"><span>{{ section.settings.credit_label }}</span></a></p>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  /* Footer v2: GetLayers "Artist" footer composition, minimal and bold. Three registers on a
     green-black ground: a quiet 5 | 2 | 2 | 3 column row, the brand word at full width, a hairline bar.
     Ground: --c-abyss, Pantone Black 3 C deepened towards black. Square, like the rest of the site. */
  .site-footer { position: relative; margin-top: var(--s-6); background: var(--c-abyss); color: var(--c-mist); }
  .footer__shell { padding-top: clamp(4rem, 2.5rem + 5vw, 7rem); }

  .footer__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7) var(--s-5); }
  .footer__brand, .footer__col--contact { grid-column: 1 / -1; }
  @media (min-width: 990px) {
    .footer__row { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-6); }
    .footer__brand { grid-column: span 5; padding-right: var(--s-7); }
    .footer__col { grid-column: span 2; }
    .footer__col--contact { grid-column: span 3; }
  }
  .footer__logo { display: inline-block; }
  .footer__logo img { width: 132px; height: auto; }
  .footer__tagline { margin-top: var(--s-5); max-width: 28ch; font: italic var(--w-light) var(--fs-xl)/1.3 var(--f-body); letter-spacing: var(--ls-tight); color: rgba(223, 224, 219, .78); }
  .footer__label { font: var(--type-label); letter-spacing: var(--ls-label); text-transform: uppercase; color: rgba(223, 224, 219, .55); margin-bottom: var(--s-4); }

  /* sign-up: a single hairline, the size of the words is the affordance */
  .footer__signup { margin-top: var(--s-7); max-width: 26rem; }
  .line-field { display: flex; align-items: center; gap: var(--s-3); border-bottom: 1px solid rgba(223, 224, 219, .35); transition: border-color var(--t) var(--ease); }
  .line-field:focus-within { border-color: var(--c-white); }
  .line-field.is-invalid { border-color: #e7a59c; }
  .line-field__input { flex: 1; min-width: 0; min-height: 52px; padding: 0; border: 0; background: none; color: var(--c-white); font: var(--type-lead); }
  .line-field__input::placeholder { color: rgba(223, 224, 219, .5); }
  .line-field__input:focus-visible { outline: none; }
  .line-field__btn { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; color: var(--c-white); font: var(--type-button); letter-spacing: var(--ls-button); text-transform: uppercase; white-space: nowrap; }
  .line-field__btn svg { width: 16px; height: 16px; transition: translate var(--t) var(--ease); }
  .line-field__btn:hover svg { translate: 4px 0; }
  .line-field__btn:focus-visible { outline: 2px solid var(--c-white); outline-offset: 4px; }
  .footer__form-note { margin-top: var(--s-3); font-size: var(--fs-xs); color: rgba(223, 224, 219, .62); }
  .footer__form-msg { display: flex; gap: .5rem; align-items: flex-start; margin-top: var(--s-3); font: var(--type-ui); }
  .footer__form-msg svg { width: 18px; height: 18px; flex: none; margin-top: 1px; }
  .footer__form-msg--ok { margin-top: 0; color: var(--c-spring); }
  .footer__form-msg--error { color: #f0b8b0; }

  .footer__col li + li { margin-top: .25rem; }
  .footer__link { display: inline-flex; align-items: flex-start; min-height: 32px; padding-block: 4px; color: var(--c-mist); font-size: var(--fs-md); }
  .footer__link > span { display: inline-block; opacity: .82; transition: translate var(--t) cubic-bezier(.34, 1.4, .64, 1), opacity var(--t-fast) var(--ease); }
  @media (hover: hover) { .footer__link:hover > span { translate: 4px 0; opacity: 1; } }
  .footer__link[aria-current="page"] > span { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  .footer__contact .footer__link > span { word-break: break-word; }
  .footer__addr { padding-block: 4px; font-size: var(--fs-md); line-height: 1.5; color: rgba(223, 224, 219, .75); }

  /* the brand word: full width, fitted, never cropped */
  .footer__word { container-type: inline-size; margin-top: clamp(4rem, 2.5rem + 5vw, 7rem); }
  .footer__word-text {
    display: flex; justify-content: space-between; width: 100%;
    font: var(--w-bold) calc(100cqw / 3.70)/.78 var(--f-body); letter-spacing: 0; color: var(--c-mist);
    font-variant-ligatures: none; white-space: nowrap; overflow: hidden; padding-top: .04em;
  }
  .footer__word-text span { display: inline-block; }
  /* Raleway Bold's M sits .062em inside its box: pull it out so the ink is flush with the left edge */
  .footer__word-text span:first-child { margin-left: -.062em; }
  .js .footer__word.reveal { opacity: 1; filter: none; transform: none; }
  .js .footer__word-text span { translate: 0 105%; transition: translate 1100ms cubic-bezier(.16, 1, .3, 1); transition-delay: calc(var(--l) * 70ms); }
  .js .footer__word.is-in .footer__word-text span { translate: 0 0; }
  @media (prefers-reduced-motion: reduce) { .js .footer__word-text span { translate: none; transition: none; } }

  .footer__bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3) var(--s-5);
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem); padding-block: var(--s-5) calc(var(--s-6) + env(safe-area-inset-bottom));
    border-top: 1px solid rgba(223, 224, 219, .16); font-size: var(--fs-xs); color: rgba(223, 224, 219, .7);
  }
  .footer__legal { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-5); }
  .footer__legal ul { display: flex; flex-wrap: wrap; gap: 0 var(--s-5); }
  .footer__legal .footer__link, .footer__credit .footer__link { font-size: var(--fs-xs); min-height: 28px; }
  .footer__credit .footer__link { letter-spacing: .04em; }
  .footer__lang { display: inline-flex; align-items: center; gap: var(--s-2); }
  .footer__lang button { min-height: 36px; padding: 0 .9rem; border: 1px solid rgba(223, 224, 219, .3); color: var(--c-mist); font-size: var(--fs-xs); font-weight: var(--w-semibold); transition: border-color var(--t-fast) var(--ease); }
  .footer__lang button:hover { border-color: var(--c-mist); }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "checkbox", "id": "show_signup", "label": "Show email sign-up", "default": true },
    { "type": "text", "id": "signup_eyebrow", "label": "Sign-up label", "default": "The Moana list" },
    { "type": "text", "id": "signup_note", "label": "Sign-up note", "default": "One email when there is something worth knowing. Unsubscribe any time." },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Korean skincare for island skin, delivered all over Mauritius." },
    { "type": "text", "id": "watermark", "label": "Footer word", "default": "Moana", "info": "Set in capitals across the full width. Decorative only. Leave empty to hide." },
    { "type": "text", "id": "credit_label", "label": "Credit line", "default": "Built by Disruptive Dodo", "info": "Shown at the very bottom. Leave empty to hide." },
    { "type": "url", "id": "credit_url", "label": "Credit link", "info": "Empty links to www.disruptivedodo.mu." }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] },
    { "type": "contact", "name": "Contact column", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us" }
    ] }
  ]
}
{% endschema %}
