<div class="page-width">{%- render 'breadcrumbs' -%}</div>
<section class="section section--tight main-page">
  <div class="page-width page-width--narrow">
    <h1 class="t-h1">{{ page.title }}</h1>
    {%- if page.content != blank -%}<div class="rte main-page__body">{{ page.content }}</div>{%- endif -%}
  </div>
</section>

{% stylesheet %}
.main-page__body { margin-top: var(--s-6); }
{% endstylesheet %}

{% schema %}
{ "name": "Page content", "settings": [] }
{% endschema %}
