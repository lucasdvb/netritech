{%- comment -%}
  Wishlist. Hearts on product cards save handles on this device (theme.js); this page fetches each saved product
  as a real card (/products/<handle>?view=card), so prices, stock and add-to-bag are always live.
  While empty it suggests a collection.
{%- endcomment -%}
<section class="section wl" aria-labelledby="wl-{{ section.id }}" data-wishlist-page>
  <div class="page-width">
    <div class="wl__head">
      <h1 class="t-title" id="wl-{{ section.id }}">{{ 'wishlist.title' | t }}</h1>
      <p class="wl__count t-small t-soft" data-wl-count aria-live="polite"></p>
    </div>
    <ul class="product-grid product-grid--4" role="list" data-wl-grid></ul>
    <div class="wl__foot" data-wl-foot hidden>
      <p class="t-xs t-soft">{{ 'wishlist.note' | t }}</p>
      <button class="wl__clear" type="button" data-wl-clear>{{ 'wishlist.clear' | t }}</button>
    </div>
    <div class="wl__empty" data-wl-empty hidden>
      <p class="wl__empty-title">{{ 'wishlist.empty' | t }}</p>
      <p class="t-soft">{{ 'wishlist.empty_text' | t }}</p>
      {%- assign c = section.settings.collection | default: collections['new'] -%}
      {%- if c.products.size > 0 -%}
        <h2 class="t-title wl__suggest">{{ section.settings.suggest_heading }}</h2>
        <ul class="product-grid product-grid--4" role="list">
          {%- for p in c.products limit: 4 -%}<li>{% render 'product-card', product: p, index: forloop.index0 %}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-wishlist-page]');
    if (!root) return;
    var grid = root.querySelector('[data-wl-grid]'), empty = root.querySelector('[data-wl-empty]'), foot = root.querySelector('[data-wl-foot]'), count = root.querySelector('[data-wl-count]');
    var labels = {{ 'wishlist.count' | t: count: 1 | json }}, labelsN = {{ 'wishlist.count' | t: count: 2 | json }};
    function W() { return window.MoanaWishlist; }
    function paintCount(n) { count.textContent = n ? (n === 1 ? labels : labelsN.replace('2', n)) : ''; }
    function render() {
      var list = W() ? W().read() : [];
      paintCount(list.length);
      empty.hidden = list.length > 0; foot.hidden = list.length === 0;
      if (!list.length) { grid.innerHTML = ''; return; }
      Promise.all(list.map(function (h) {
        return fetch({{ routes.root_url | json }}.replace(/\/$/, '') + '/products/' + encodeURIComponent(h) + '?view=card')
          .then(function (r) { return r.ok ? r.text() : ''; }).catch(function () { return ''; });
      })).then(function (cards) {
        grid.innerHTML = cards.filter(Boolean).map(function (c) { return '<li>' + c + '</li>'; }).join('');
        grid.querySelectorAll('.reveal').forEach(function (r) { r.classList.add('is-in'); });
        if (W()) W().paint();
      });
    }
    document.addEventListener('wishlist:change', function () {
      // removing a heart here removes the card straight away
      var list = W() ? W().read() : [];
      grid.querySelectorAll('[data-wishlist-toggle]').forEach(function (b) {
        if (list.indexOf(b.getAttribute('data-wishlist-toggle')) === -1) { var li = b.closest('li'); if (li) li.remove(); }
      });
      paintCount(list.length); empty.hidden = list.length > 0; foot.hidden = list.length === 0;
    });
    root.querySelector('[data-wl-clear]').addEventListener('click', function () { if (W()) { W().write([]); W().paint(); } render(); });
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', render); else render();
  })();
</script>

{% stylesheet %}
  .wl__head { display: grid; justify-items: center; gap: var(--s-2); margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .wl__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3); margin-top: var(--s-7); padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .wl__clear { font-size: var(--fs-small); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; min-height: 44px; }
  .wl__empty { display: grid; justify-items: center; text-align: center; gap: var(--s-3); }
  .wl__empty-title { font: 400 clamp(1.75rem, 1.4rem + 1.4vw, 2.75rem)/1.1 var(--f-display); }
  .wl__suggest { margin-top: var(--s-8); margin-bottom: var(--s-5); }
  .wl__empty .product-grid { width: 100%; text-align: left; }
{% endstylesheet %}

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "suggest_heading", "label": "Heading above suggestions", "default": "Need ideas? Start here" },
    { "type": "collection", "id": "collection", "label": "Suggestions" }
  ],
  "presets": [{ "name": "Wishlist" }]
}
{% endschema %}
