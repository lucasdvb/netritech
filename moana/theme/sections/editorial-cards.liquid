{%- comment -%}
  Editorial cards (Cult Beauty's "IN FOCUS" and "WHAT'S NEW AT CULT?"): a picture, a small label, an uppercase
  name, two lines of copy and a SHOP NOW button. Three across on desktop, a swipe rail on phones.
  The picture is an uploaded image, or the product's own packshot on a brand-tinted ground.
{%- endcomment -%}
<section class="section section--tight ed" aria-labelledby="ed-{{ section.id }}">
  <div class="page-width">
    <h2 class="t-title" id="ed-{{ section.id }}">{{ section.settings.heading }}</h2>
    <div class="carousel ed__wrap" data-carousel>
      <ul class="carousel__track ed__track" data-carousel-track role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product
            assign url = b.link | default: p.url
            assign btn_label = b.button
            if btn_label == blank
              assign btn_label = 'general.shop_now' | t
            endif
          -%}
          <li class="ed__card reveal" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <a class="ed__media ed__media--{{ b.tint }}" href="{{ url }}" tabindex="-1" aria-hidden="true">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 900 | image_tag: widths: '450, 675, 900', sizes: '(min-width: 990px) 30vw, 80vw', loading: 'lazy', alt: '' }}
              {%- elsif p != blank -%}
                <span class="ed__pack">{{ p.featured_media.preview_image | image_url: width: 700 | image_tag: widths: '350, 525, 700', sizes: '(min-width: 990px) 20vw, 50vw', loading: 'lazy', alt: '' }}</span>
              {%- endif -%}
            </a>
            <div class="ed__body">
              {%- if b.label != blank -%}<p class="ed__label">{{ b.label }}</p>{%- endif -%}
              <h3 class="ed__name">{{ b.name | default: p.vendor }}</h3>
              {%- if b.text != blank -%}<p class="ed__text">{{ b.text }}</p>{%- endif -%}
              <a class="btn{% if section.settings.outline %} btn--secondary{% endif %} ed__btn" href="{{ url }}">{{ btn_label }}<span class="sr-only">: {{ b.name | default: p.title }}</span></a>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <button class="carousel__arrow carousel__arrow--prev" type="button" data-carousel-prev>{% render 'icon', name: 'chevron-left' %}<span class="sr-only">{{ 'general.prev_slide' | t }}</span></button>
      <button class="carousel__arrow carousel__arrow--next" type="button" data-carousel-next>{% render 'icon', name: 'chevron-right' %}<span class="sr-only">{{ 'general.next_slide' | t }}</span></button>
      <div class="carousel__dots" data-carousel-dots role="group" aria-label="{{ 'general.slides' | t }}"></div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ed .t-title { margin-bottom: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .ed__track { grid-auto-columns: calc((100% - 2 * 2.5rem) / 3); gap: 2.5rem; }
  @media (max-width: 989px) { .ed__track { grid-auto-columns: 78%; gap: 1rem; } }
  .ed__card { display: flex; flex-direction: column; text-align: center; }
  .ed__media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-frost); }
  .ed__media--spring { background: linear-gradient(165deg, #f3f5ec 0%, var(--c-spring) 100%); }
  .ed__media--linen { background: linear-gradient(165deg, #f6f3ee 0%, var(--c-linen) 100%); }
  .ed__media--sage { background: linear-gradient(165deg, var(--c-spring) 0%, var(--c-sage) 100%); }
  .ed__media--night { background: radial-gradient(120% 90% at 50% 20%, #3a4636 0%, var(--c-night) 70%); }
  .ed__media > img { width: 100%; height: 100%; object-fit: cover; transition: transform 1100ms var(--ease-out); }
  .ed__pack { position: absolute; inset: 8% 25%; display: block; transition: transform 1100ms var(--ease-out); }
  .ed__pack img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .ed__media--night .ed__pack img { mix-blend-mode: normal; filter: drop-shadow(0 18px 24px rgba(0,0,0,.45)); }
  .ed__card:hover .ed__media > img, .ed__card:hover .ed__pack { transform: scale(1.05); }
  .ed__body { display: grid; justify-items: center; gap: var(--s-2); padding-top: var(--s-5); flex: 1; align-content: start; }
  .ed__label { font: 500 .8125rem/1.3 var(--f-body); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); }
  .ed__name { font: 500 clamp(1.0625rem, 1rem + .3vw, 1.25rem)/1.3 var(--f-body); letter-spacing: .04em; text-transform: uppercase; }
  .ed__text { max-width: 26rem; font-size: .9375rem; line-height: 1.55; color: var(--ink-soft); text-wrap: pretty; }
  .ed__btn { margin-top: auto; min-width: 12rem; }
  .ed__body .ed__text + .ed__btn, .ed__body .ed__name + .ed__btn { margin-top: var(--s-4); }
  .ed .carousel__arrow { top: 30%; }
  @media (min-width: 990px) { .ed .carousel.is-static .carousel__dots { display: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial cards",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "In focus" },
    { "type": "checkbox", "id": "outline", "label": "Outline buttons", "default": false }
  ],
  "max_blocks": 8,
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "label", "label": "Small label", "default": "On our wishlist" },
      { "type": "text", "id": "name", "label": "Name (defaults to the product's brand)" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "button", "label": "Button label", "default": "Shop now" },
      { "type": "url", "id": "link", "label": "Link (defaults to the product)" },
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "image_picker", "id": "image", "label": "Image (overrides the packshot)" },
      { "type": "select", "id": "tint", "label": "Packshot ground", "default": "spring", "options": [
        { "value": "spring", "label": "Spring" }, { "value": "linen", "label": "Khaki Linen" }, { "value": "sage", "label": "Sage" }, { "value": "night", "label": "Night" }
      ] }
    ] }
  ],
  "presets": [{ "name": "Editorial cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
