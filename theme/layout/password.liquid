<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#283106">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" href="{{ 'favicon-32.png' | asset_url }}" sizes="32x32">
  {{ 'raleway-200-700-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% render 'fonts' %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <title>{{ 'password.title' | t }} · {{ settings.brand_name | default: shop.name }}</title>
  <meta name="description" content="{{ 'password.lead' | t | escape }}">
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
