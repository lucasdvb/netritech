{%- liquid
  assign site_name = settings.brand_name | default: shop.name
  assign meta_title = page_title
  assign meta_desc = page_description | strip_html | strip_newlines | truncate: 160
  case template.name
    when 'index'
      assign meta_title = 'meta.home_title' | t
      if meta_desc == blank
        assign meta_desc = 'meta.home_description' | t
      endif
    when 'collection'
      if meta_desc == blank
        assign meta_desc = 'meta.collection_description' | t: title: collection.title
      endif
  endcase
  if meta_desc == blank
    assign meta_desc = 'meta.home_description' | t
  endif
  assign og_type = 'website'
  if template.name == 'product'
    assign og_type = 'product'
  elsif template.name == 'article'
    assign og_type = 'article'
  endif
-%}
<title>
  {{- meta_title | escape -}}
  {%- if current_tags %} · {{ current_tags | join: ', ' | escape }}{% endif -%}
  {%- if current_page != 1 %} · {{ 'general.page_n' | t: page: current_page }}{% endif -%}
  {%- unless meta_title contains site_name %} · {{ site_name | escape }}{% endunless -%}
</title>
{%- if meta_desc != blank %}
<meta name="description" content="{{ meta_desc | escape }}">
{%- endif %}
{%- if template.name == 'search' or template.name == 'cart' or template contains 'customers' or template.suffix == 'wishlist' %}
<meta name="robots" content="noindex, follow">
{%- endif %}
<meta property="og:site_name" content="{{ site_name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ meta_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
{%- if meta_desc != blank %}
<meta property="og:description" content="{{ meta_desc | escape }}">
{%- endif %}
{%- if page_image %}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
{%- else %}
<meta property="og:image" content="https:{{ 'og-default.jpg' | asset_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- endif %}
{%- if template.name == 'product' %}
<meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | remove: ',' }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta_title | escape }}">
{%- if meta_desc != blank %}
<meta name="twitter:description" content="{{ meta_desc | escape }}">
{%- endif %}
