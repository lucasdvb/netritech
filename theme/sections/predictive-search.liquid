{%- comment -%} Rendered by /search/suggest?section_id=predictive-search. Only the inner markup is swapped in. {%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- assign res = predictive_search.resources -%}
  <div class="predictive" data-predictive>
    {%- if res.products.size > 0 or res.collections.size > 0 or res.pages.size > 0 or res.queries.size > 0 -%}
      <div class="predictive__grid">
        <div class="predictive__side">
          {%- if res.queries.size > 0 -%}
            <p class="t-label">{{ 'search.suggestions' | t }}</p>
            <ul role="list" class="predictive__list">
              {%- for q in res.queries -%}<li><a href="{{ q.url }}" role="option">{{ q.styled_text }}</a></li>{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if res.collections.size > 0 -%}
            <p class="t-label">{{ 'search.collections' | t }}</p>
            <ul role="list" class="predictive__list">
              {%- for c in res.collections -%}<li><a href="{{ c.url }}" role="option">{{ c.title }}</a></li>{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if res.pages.size > 0 -%}
            <p class="t-label">{{ 'search.pages' | t }}</p>
            <ul role="list" class="predictive__list">
              {%- for p in res.pages -%}<li><a href="{{ p.url }}" role="option">{{ p.title }}</a></li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
        <div>
          {%- if res.products.size > 0 -%}
            <p class="t-label">{{ 'search.products' | t }}</p>
            <ul role="list" class="predictive__products">
              {%- for product in res.products limit: 6 -%}
                <li>
                  <a class="predictive__product" href="{{ product.url }}" role="option">
                    <span class="predictive__img">{%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 160 | image_tag: widths: '80, 160', sizes: '64px', alt: '', loading: 'lazy' }}{%- endif -%}</span>
                    <span><span class="card__vendor">{{ product.vendor }}</span><span class="predictive__name">{{ product.title }}</span></span>
                    <span class="t-price">{{ product.price | money }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
      <a class="btn btn--secondary predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last">{{ 'search.view_all' | t: terms: predictive_search.terms }}</a>
    {%- else -%}
      <p class="predictive__none">{{ 'search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

