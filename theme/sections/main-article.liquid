<div class="page-width">{%- render 'breadcrumbs' -%}</div>
<article class="section section--tight">
  <div class="page-width page-width--narrow">
    <p class="t-xs t-soft">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="t-h1" style="margin-top: var(--s-3)">{{ article.title }}</h1>
    {%- if article.image -%}
      <div class="media ratio-16-9 rounded" style="margin-top: var(--s-6)">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 832px, 100vw', loading: 'eager', fetchpriority: 'high', alt: article.image.alt | default: '' }}</div>
    {%- endif -%}
    <div class="rte" style="margin-top: var(--s-6)">{{ article.content }}</div>
    <p style="margin-top: var(--s-7)"><a class="link-arrow" href="{{ blog.url }}">{% render 'icon', name: 'arrow-right' %} {{ 'blog.back' | t }}</a></p>
  </div>
</article>
<script type="application/ld+json">{{ article | structured_data }}</script>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
