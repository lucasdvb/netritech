<section class="section info" aria-labelledby="info-{{ section.id }}">
  <div class="page-width info__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="t-label">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="t-h2" id="info-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div>
      <dl class="info__rows">
        {%- for block in section.blocks -%}
          <div class="info__row" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label }}</dt>
            <dd class="rte">{{ block.settings.value }}</dd>
          </div>
        {%- endfor -%}
      </dl>
      {%- if section.settings.note != blank -%}<div class="rte t-soft info__note">{{ section.settings.note }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.info__grid { display: grid; gap: var(--s-6); }
.info__grid > div:first-child > * + * { margin-top: var(--s-3); }
.info__rows { border-top: 1px solid var(--line); }
.info__row { display: grid; gap: var(--s-2); padding-block: var(--s-5); border-bottom: 1px solid var(--line); }
.info__row dt { font: 700 var(--fs-label)/1.6 var(--f-body); letter-spacing: .16em; text-transform: uppercase; color: var(--brand); }
.info__row dd { font-size: 1.0625rem; }
.info__note { margin-top: var(--s-5); font-size: var(--fs-small); }
@media (min-width: 750px) { .info__row { grid-template-columns: 11rem 1fr; gap: var(--s-6); } }
@media (min-width: 990px) { .info__grid { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(3rem, 7vw, 8rem); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Information table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery" },
    { "type": "richtext", "id": "note", "label": "Note" }
  ],
  "blocks": [ { "type": "row", "name": "Row", "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Where" },
    { "type": "richtext", "id": "value", "label": "Value", "default": "<p>Anywhere in Mauritius.</p>" }
  ] } ],
  "presets": [{ "name": "Information table" }]
}
{% endschema %}
