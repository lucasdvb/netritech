{%- paginate search.results by 24 -%}
<div class="page-width">{%- render 'breadcrumbs' -%}</div>
<section class="section section--flush-top search-page">
  <div class="page-width">
    <header class="search-page__head">
      <h1 class="t-h1">{% if search.performed %}{{ 'search.results_for' | t: terms: search.terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
      <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="sr-only" for="search-page-input">{{ 'search.label' | t }}</label>
        <input class="input" id="search-page-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button class="btn" type="submit">{{ 'search.submit' | t }}</button>
      </form>
      {%- if search.performed -%}
        <p class="t-small t-soft" role="status">{{ 'search.count' | t: count: search.results_count, terms: search.terms }}</p>
      {%- endif -%}
    </header>

    {%- if search.performed and search.results_count > 0 -%}
      {%- assign others = search.results | where: 'object_type', 'page' -%}
      <ul class="product-grid product-grid--4" role="list">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            <li>{%- render 'product-card', product: item, index: forloop.index0, heading: 'h2' -%}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if others.size > 0 -%}
        <div class="search-page__others">
          <p class="t-label">{{ 'search.pages' | t }}</p>
          <ul role="list">{%- for p in others -%}<li><a class="link" href="{{ p.url }}">{{ p.title }}</a></li>{%- endfor -%}</ul>
        </div>
      {%- endif -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- elsif search.performed -%}
      <div class="plp__empty">
        <h2 class="t-h3">{{ 'search.no_results' | t: terms: search.terms }}</h2>
        <p class="t-soft">{{ 'search.no_results_hint' | t }}</p>
        <div class="cluster">{%- render 'tag-counts', source: collections['skincare'], tags: settings.concern_tags, style: 'pills' -%}</div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% stylesheet %}
.search-page__head { display: grid; gap: var(--s-5); padding-top: clamp(1.5rem, .8rem + 2.4vw, 4rem); margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem); max-width: 48rem; }
.search-page__form { display: grid; grid-template-columns: 1fr auto; gap: var(--s-2); }
.search-page__others { margin-top: var(--s-8); display: grid; gap: var(--s-3); }
.search-page__others ul { display: grid; gap: var(--s-2); }
{% endstylesheet %}

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
