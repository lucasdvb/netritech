<section class="section{% if section.settings.wash %} section--wash{% endif %}" aria-labelledby="pl-{{ section.id }}">
  <div class="page-width">
    <div class="section-head"><div class="section-head__text">
      {%- if section.settings.eyebrow != blank -%}<p class="t-label">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="t-h2" id="pl-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="t-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div></div>
    <ul class="product-grid" role="list">
      {%- for product in section.settings.products -%}
        <li>{%- render 'product-card', product: product, index: forloop.index0 -%}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Product list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Begin with three steps" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8 },
    { "type": "checkbox", "id": "wash", "label": "Spring background", "default": false }
  ],
  "presets": [{ "name": "Product list" }]
}
{% endschema %}
