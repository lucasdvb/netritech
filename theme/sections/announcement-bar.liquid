{%- comment -%} Promo bar (Cult Beauty's coloured strip), in forest. Several messages take turns. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="announce" role="region" aria-label="{{ 'header.announcement' | t }}" data-rotator>
  <div class="page-width announce__inner">
    {%- for block in section.blocks -%}
      <p class="announce__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .announce { background: var(--c-forest); color: var(--c-white); }
  .announce__inner { display: grid; min-height: 42px; }
  .announce__item { grid-area: 1 / 1; display: flex; align-items: center; justify-content: center; padding-block: 8px; text-align: center; font: 500 .8125rem/1.4 var(--f-body); letter-spacing: .08em; text-transform: uppercase;
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity 400ms var(--ease), transform 400ms var(--ease), visibility 0s linear 400ms; }
  .announce__item.is-active { opacity: 1; visibility: visible; transform: none; transition: opacity 400ms var(--ease), transform 400ms var(--ease); }
  .announce a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.5); }
  .announce a:hover { text-decoration-color: currentColor; }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo bar",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery all over Mauritius over Rs 1,500" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Promo bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
