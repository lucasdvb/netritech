<section class="pw">
  <div class="pw__inner">
    <img class="pw__logo" src="{{ 'logo-lockup-light.webp' | asset_url }}" alt="{{ settings.brand_name | default: shop.name | escape }}" width="900" height="436">
    <h1 class="t-h1">{{ 'password.heading' | t }}</h1>
    {%- assign pw_lead = 'password.lead' | t -%}
    <p class="pw__lead">{{ shop.password_message | default: pw_lead }}</p>
    <p class="pw__contact"><a href="mailto:{{ shop.email }}">{{ shop.email }}</a>{% if settings.whatsapp_display != blank %} · <a href="https://wa.me/{{ settings.whatsapp_number }}">{{ 'general.whatsapp' | t }} {{ settings.whatsapp_display }}</a>{% endif %}</p>
    <details class="pw__login"{% if form.errors %} open{% endif %}>
      <summary>{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'pw__form' -%}
        <label class="sr-only" for="pw-input">{{ 'password.field' | t }}</label>
        <input class="input" id="pw-input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.field' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="pw-err"{% endif %}>
        <button class="btn btn--light" type="submit">{{ 'password.enter' | t }}</button>
        {%- if form.errors -%}<p class="field__error" id="pw-err" role="alert">{{ 'password.wrong' | t }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% stylesheet %}
.template-password { background: var(--c-forest); color: var(--c-mist); }
.pw { min-height: 100svh; display: grid; place-items: center; padding: var(--s-7) var(--gutter); text-align: center; }
.pw__inner { display: grid; justify-items: center; gap: var(--s-5); max-width: 36rem; }
.pw__logo { width: min(240px, 60vw); height: auto; margin-bottom: var(--s-5); }
.pw .t-h1 { color: var(--c-white); }
.pw__lead { font-size: var(--fs-lead); color: rgba(223,224,219,.86); }
.pw__contact a { color: var(--c-mist); text-decoration: underline; text-underline-offset: 3px; }
.pw__login { margin-top: var(--s-6); font-size: var(--fs-small); }
.pw__login summary { cursor: pointer; color: rgba(223,224,219,.8); }
.pw__form { display: grid; grid-template-columns: 1fr auto; gap: var(--s-2); margin-top: var(--s-4); }
.pw__form .field__error { grid-column: 1 / -1; color: #f2c4bd; }
{% endstylesheet %}

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
