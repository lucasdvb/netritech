{%- comment -%}
  Header, laid out after Cult Beauty: a real search field on the left, the logo in the centre, and a
  "Find my routine" button, wishlist, account and bag on the right; the category navigation sits centred
  underneath. Once the page scrolls it turns to frosted glass (GetLayers House treatment) and tucks away on
  scroll down.
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  assign shop_source = section.settings.shop_collection | default: collections['skincare']
  assign brand_name = settings.brand_name | default: shop.name
  assign mega_handle = section.settings.mega_item | handle
-%}
<header class="site-header" data-header>
  <div class="page-width header">
    <div class="header__start">
      <button class="icon-btn header__burger" type="button" aria-controls="menu-drawer" aria-expanded="false" data-drawer-open="menu-drawer">
        {%- render 'icon', name: 'menu' -%}<span class="sr-only">{{ 'header.menu' | t }}</span>
      </button>
      <a class="icon-btn header__search-icon" href="{{ routes.search_url }}" data-search-open aria-haspopup="dialog">
        {%- render 'icon', name: 'search' -%}<span class="sr-only">{{ 'header.search' | t }}</span>
      </a>
      <form class="header__search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="sr-only" for="header-search">{{ 'search.label' | t }}</label>
        <input class="header__search-input" id="header-search" type="search" name="q" autocomplete="off" placeholder="{{ 'search.placeholder' | t }}" data-search-trigger>
        <input type="hidden" name="options[prefix]" value="last">
        <button class="header__search-btn" type="submit">{%- render 'icon', name: 'search' -%}<span class="sr-only">{{ 'search.submit' | t }}</span></button>
      </form>
    </div>

    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: widths: '140, 210, 280, 400', sizes: '140px', alt: brand_name, fetchpriority: 'high', loading: 'eager' }}
      {%- else -%}
        <img src="{{ 'logo-lockup-dark.webp' | asset_url }}" alt="{{ brand_name | escape }}" width="900" height="436" fetchpriority="high" decoding="async">
      {%- endif -%}
    </a>

    <div class="header__end">
      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <a class="header__cta" href="{{ section.settings.cta_link }}">{% render 'icon', name: 'sparkle' %}<span>{{ section.settings.cta_label }}</span></a>
      {%- endif -%}
      <a class="header__action hide-mobile-sm" href="{{ routes.root_url }}pages/wishlist" data-wishlist-link>
        {%- render 'icon', name: 'heart' -%}<span class="header__action-label">{{ 'header.wishlist' | t }}</span>
        <span class="header__badge" data-wishlist-count hidden></span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="header__action" href="{{ routes.account_url }}">
          {%- render 'icon', name: 'user' -%}<span class="header__action-label">{{ 'header.account' | t }}</span>
        </a>
      {%- endif -%}
      <a class="header__action header__icon" href="{{ routes.cart_url }}" id="cart-icon" data-cart-open aria-haspopup="dialog">
        {%- render 'icon', name: 'bag' -%}<span class="header__action-label">{{ 'header.cart' | t }}</span>
        {%- render 'cart-count' -%}
      </a>
    </div>
  </div>

  <nav class="header__nav" aria-label="{{ 'header.primary_nav' | t }}">
    <ul class="header__nav-list" role="list">
      {%- for link in menu.links -%}
        {%- liquid
          assign is_mega = false
          assign link_handle = link.title | handle
          if link.links.size > 0 and link_handle == mega_handle
            assign is_mega = true
          endif
        -%}
        <li{% if is_mega %} data-mega{% endif %}>
          {%- if is_mega -%}
            <button class="nav-link" type="button" aria-expanded="false" aria-controls="mega-{{ forloop.index }}" data-mega-toggle>
              {{ link.title }} {% render 'icon', name: 'chevron-down' %}
            </button>
            <div class="mega" id="mega-{{ forloop.index }}" data-mega-panel>
              <div class="page-width mega__inner">
                <div class="mega__col">
                  <h3 class="mega__title">{{ 'header.by_category' | t }}</h3>
                  <ul role="list">
                    <li><a href="{{ link.url }}">{{ 'header.shop_all' | t }} <small>{{ link.object.products_count }}</small></a></li>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}{% if child.type == 'collection_link' %} <small>{{ child.object.products_count }}</small>{% endif %}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
                <div class="mega__col">
                  <h3 class="mega__title">{{ 'header.by_concern' | t }}</h3>
                  <ul role="list">{% render 'tag-counts', source: shop_source, tags: settings.concern_tags %}</ul>
                </div>
                <div class="mega__col">
                  <h3 class="mega__title">{{ 'header.by_skin_type' | t }}</h3>
                  <ul role="list">{% render 'tag-counts', source: shop_source, tags: settings.skin_type_tags %}</ul>
                </div>
                <div class="mega__feature">
                  {%- for block in section.blocks -%}
                    {%- liquid
                      assign card_img = block.settings.image
                      if card_img == blank and block.settings.collection != blank
                        assign card_img = block.settings.collection.featured_image | default: block.settings.collection.products.first.featured_media.preview_image
                      endif
                    -%}
                    <a class="mega-card" href="{{ block.settings.link | default: block.settings.collection.url }}" {{ block.shopify_attributes }}>
                      <span class="media ratio-1{% if block.settings.image == blank %} media--contain{% endif %}">
                        {%- if card_img -%}{{ card_img | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '220px', loading: 'lazy', alt: '' }}{%- endif -%}
                      </span>
                      <span class="mega-card__eyebrow">{{ block.settings.eyebrow }}</span>
                      <span class="mega-card__title">{{ block.settings.title }}</span>
                    </a>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- else -%}
            <a class="nav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

{%- comment -%} Phone and tablet menu. The same information as the mega menu, as an accordion. {%- endcomment -%}
<div class="drawer drawer--left menu-drawer" id="menu-drawer" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}" tabindex="-1">
  <div class="drawer__head">
    <img src="{{ 'logo-lockup-dark.webp' | asset_url }}" alt="" width="900" height="436" style="height:40px;width:auto" loading="lazy">
    <button class="icon-btn" type="button" data-drawer-close>{%- render 'icon', name: 'close' -%}<span class="sr-only">{{ 'general.close' | t }}</span></button>
  </div>
  <div class="drawer__body">
    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a class="btn btn--full menu-drawer__cta" href="{{ section.settings.cta_link }}">{% render 'icon', name: 'sparkle' %}{{ section.settings.cta_label }}</a>
    {%- endif -%}
    <nav class="menu-drawer__nav" aria-label="{{ 'header.primary_nav' | t }}">
      {%- for link in menu.links -%}
        {%- assign link_handle = link.title | handle -%}
        {%- if link.links.size > 0 and link_handle == mega_handle -%}
          <details open>
            <summary class="menu-drawer__link">{{ link.title }} {% render 'icon', name: 'plus' %}</summary>
            <div class="menu-drawer__sub">
              <div>
                <p class="mega__title">{{ 'header.by_category' | t }}</p>
                <ul role="list">
                  <li><a href="{{ link.url }}">{{ 'header.shop_all' | t }} <small>{{ link.object.products_count }}</small></a></li>
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}{% if child.type == 'collection_link' %} <small>{{ child.object.products_count }}</small>{% endif %}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
              <div>
                <p class="mega__title">{{ 'header.by_concern' | t }}</p>
                <ul role="list">{% render 'tag-counts', source: shop_source, tags: settings.concern_tags %}</ul>
              </div>
              <div>
                <p class="mega__title">{{ 'header.by_skin_type' | t }}</p>
                <ul role="list">{% render 'tag-counts', source: shop_source, tags: settings.skin_type_tags %}</ul>
              </div>
            </div>
          </details>
        {%- else -%}
          <a class="menu-drawer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
    <div class="menu-drawer__secondary">
      <a href="{{ routes.root_url }}pages/wishlist">{% render 'icon', name: 'heart' %}{{ 'header.wishlist' | t }}</a>
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">{% render 'icon', name: 'user' %}{{ 'header.account' | t }}</a>{%- endif -%}
      {%- for link in linklists[section.settings.secondary_menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .site-header {
    position: sticky; top: 0; z-index: 60; background: var(--c-white);
    transition: background-color var(--t) var(--ease), box-shadow var(--t) var(--ease), transform var(--t-slow) var(--ease-out);
  }
  /* frosted glass once the page moves under it */
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, .8);
    -webkit-backdrop-filter: saturate(1.6) blur(20px); backdrop-filter: saturate(1.6) blur(20px);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header.is-hidden { transform: translateY(-100%); }
  .header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s-3); height: 64px; }
  .header__start, .header__end { display: flex; align-items: center; gap: 0; min-width: 0; }
  .header__end { justify-content: flex-end; }
  .header__burger { margin-left: -10px; }
  .header__logo { display: block; line-height: 0; }
  .header__logo img { width: auto; height: 46px; }

  .header__search { display: none; position: relative; width: 100%; max-width: 30rem; }
  .header__search-input {
    width: 100%; height: 46px; padding: 0 3rem 0 .9rem; border: 1px solid var(--ink); border-radius: 0; background: var(--c-white);
    font-size: 1rem; color: var(--ink); -webkit-appearance: none; appearance: none;
  }
  .header__search-input::placeholder { color: rgba(52,52,52,.72); }
  .header__search-input::-webkit-search-cancel-button { display: none; }
  .header__search-input:focus-visible { outline: 2px solid var(--c-forest); outline-offset: 1px; }
  .header__search-btn { position: absolute; right: 0; top: 0; width: 46px; height: 46px; display: grid; place-items: center; }
  .header__search-btn svg { width: 22px; height: 22px; }

  .header__cta {
    display: none; position: relative; align-items: center; gap: .5rem; height: 42px; margin-right: var(--s-2); padding: 0 1rem;
    background: var(--c-night); color: var(--c-white); font: 700 .75rem/1 var(--f-body); letter-spacing: .1em; text-transform: uppercase; white-space: nowrap;
    overflow: hidden; isolation: isolate;
  }
  .header__cta::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--c-forest); transform: translateX(-101%); transition: transform var(--t) var(--ease); }
  @media (hover: hover) { .header__cta:hover::before { transform: none; } }
  .header__cta svg { width: 16px; height: 16px; }
  .header__action { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-width: 44px; height: 44px; padding: 0 8px; font: 500 .875rem/1 var(--f-body); letter-spacing: .03em; color: var(--ink); }
  .header__action svg { width: 22px; height: 22px; flex: none; }
  .header__action-label { display: none; }
  @media (hover: hover) { .header__action:hover .header__action-label { text-decoration: underline; text-underline-offset: 4px; } }
  .header__badge { position: absolute; top: 3px; left: 22px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background: var(--c-forest); color: var(--c-white); font: 700 10px/18px var(--f-body); text-align: center; }
  .header__icon .cart-count { top: 2px; right: auto; left: 20px; }
  @media (max-width: 420px) { .hide-mobile-sm { display: none !important; } .header__action { padding: 0 4px; min-width: 40px; } }

  .header__nav { display: none; }
  @media (min-width: 990px) {
    .header { height: 84px; }
    .header__logo img { height: 60px; }
    .header__burger, .header__search-icon { display: none; }
    .header__search { display: block; }
    .header__cta { display: inline-flex; }
    .header__nav { display: block; position: relative; }
    .header__nav-list { display: flex; justify-content: center; flex-wrap: wrap; gap: 0 var(--s-1); padding-bottom: 6px; }
  }
  @media (min-width: 1280px) { .header__action-label { display: inline; } }

  .nav-link {
    position: relative; display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 12px;
    font: 500 .875rem/1 var(--f-body); letter-spacing: .03em; color: var(--ink); white-space: nowrap;
  }
  .nav-link::after { content: ""; position: absolute; left: 12px; right: 12px; bottom: 6px; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform var(--t) var(--ease); }
  .nav-link:hover::after, .nav-link[aria-expanded="true"]::after, .nav-link[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
  .nav-link svg { width: 12px; height: 12px; transition: transform var(--t) var(--ease); }
  .nav-link[aria-expanded="true"] svg { transform: rotate(180deg); }

  .mega {
    position: absolute; left: 0; right: 0; top: 100%; background: rgba(255,255,255,.9); border-top: 1px solid var(--line);
    -webkit-backdrop-filter: saturate(1.6) blur(24px); backdrop-filter: saturate(1.6) blur(24px);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity var(--t) var(--ease), transform var(--t) var(--ease), visibility 0s linear var(--t);
    box-shadow: 0 30px 50px -40px rgba(33,39,33,.45);
  }
  .mega.is-open { opacity: 1; visibility: visible; transform: none; transition: opacity var(--t) var(--ease), transform var(--t) var(--ease); }
  .mega__inner { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.4fr); gap: var(--s-7); padding-block: var(--s-6) var(--s-7); }
  .mega__title { font: 700 .75rem/1.4 var(--f-body); letter-spacing: .14em; text-transform: uppercase; color: var(--ink); margin-bottom: var(--s-3); }
  .mega__col li + li { margin-top: 2px; }
  .mega__col a { display: inline-flex; align-items: baseline; gap: .45rem; padding: 5px 0; font-size: .9375rem; color: var(--ink); }
  .mega__col a small { font-size: var(--fs-xs); color: var(--ink-soft); }
  .mega__col a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .mega__feature { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
  .mega-card { display: grid; gap: var(--s-2); align-content: start; }
  .mega-card .media img { transition: transform var(--t-slow) var(--ease-out); }
  .mega-card:hover .media img { transform: scale(1.04); }
  .mega-card__eyebrow { font: 700 .6875rem/1.3 var(--f-body); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); }
  .mega-card__title { font: 400 1.25rem/1.2 var(--f-display); }

  .menu-drawer .drawer__body { padding: 0; }
  .menu-drawer__cta { margin: var(--s-4) var(--s-5) 0; width: calc(100% - 2 * var(--s-5)); }
  .menu-drawer__nav { padding: var(--s-2) var(--s-5) var(--s-6); }
  .menu-drawer__link { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 56px; border-bottom: 1px solid var(--line); font: 500 .9375rem/1.2 var(--f-body); letter-spacing: .08em; text-transform: uppercase; color: var(--ink); text-align: left; }
  .menu-drawer__link svg { width: 18px; height: 18px; }
  .menu-drawer details > summary { list-style: none; cursor: pointer; }
  .menu-drawer details > summary::-webkit-details-marker { display: none; }
  .menu-drawer details[open] > summary svg { transform: rotate(45deg); }
  .menu-drawer details > summary svg { transition: transform var(--t) var(--ease); }
  .menu-drawer__sub { padding: var(--s-4) 0 var(--s-5); display: grid; gap: var(--s-5); border-bottom: 1px solid var(--line); }
  .menu-drawer__sub ul { display: grid; gap: 2px; }
  .menu-drawer__sub a { display: flex; justify-content: space-between; align-items: center; min-height: 40px; font-size: 1rem; }
  .menu-drawer__sub a small { color: var(--ink-soft); font-size: var(--fs-xs); }
  .menu-drawer__secondary { display: grid; gap: var(--s-1); padding: var(--s-4) var(--s-5) var(--s-6); border-top: 1px solid var(--line); background: var(--c-frost); }
  .menu-drawer__secondary a { display: flex; align-items: center; gap: .6rem; min-height: 40px; font-size: var(--fs-small); font-weight: 600; }
  .menu-drawer__secondary svg { width: 18px; height: 18px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo override", "info": "Leave empty to use the official dark lockup shipped with the theme." },
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "text", "id": "mega_item", "label": "Menu item that opens the mega menu", "default": "Skincare" },
    { "type": "collection", "id": "shop_collection", "label": "Collection for concern and skin-type links", "info": "Concern and skin-type lists come from Theme settings > Discovery." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Find my routine" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "link_list", "id": "secondary_menu", "label": "Secondary menu (phone menu footer)", "default": "footer" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Mega menu card",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Label", "default": "New in" },
        { "type": "text", "id": "title", "label": "Title", "default": "Fresh drops, all in one place" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link (overrides collection)" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ]
}
{% endschema %}
